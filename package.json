{
  "name": "cubiverso",
  "productName": "Cubiverso",
  "version": "1.1.0",
  "description": "Cubiverso: juegos, avatar y CuboStudio",
  "author": "Toni-games",
  "main": "main.js",
  "private": true,
  "build": {
    "appId": "com.cubiverso.app",
    "productName": "Cubiverso",
    "files": ["main.js", "icon.png", "web/**/*"],
    "directories": {"output": "salida"},
    "win": {"target": [{"target": "nsis", "arch": ["x64"]}, {"target": "portable", "arch": ["x64"]}], "icon": "icon.png"},
    "nsis": {"oneClick": false, "perMachine": false, "allowToChangeInstallationDirectory": true, "createDesktopShortcut": true, "createStartMenuShortcut": true, "shortcutName": "Cubiverso", "artifactName": "Cubiverso-Instalador.exe", "language": "3082"},
    "portable": {"artifactName": "Cubiverso-Portable.exe"}
  },
  "devDependencies": {"electron": "33.2.1", "electron-builder": "25.1.8"}
}
