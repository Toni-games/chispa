{
  "name": "cubiverso-launcher",
  "productName": "Cubiverso Launcher",
  "version": "1.0.0",
  "description": "Launcher de Cubiverso: elige la versión y juega con tu cuenta",
  "author": "Toni-games",
  "main": "main.js",
  "private": true,
  "build": {
    "appId": "com.cubiverso.launcher",
    "productName": "Cubiverso Launcher",
    "files": ["main.js", "preload.js", "icon.png", "launcher/**/*", "lib/**/*"],
    "directories": {"output": "salida"},
    "win": {"target": [{"target": "nsis", "arch": ["x64"]}, {"target": "portable", "arch": ["x64"]}], "icon": "icon.png"},
    "nsis": {"oneClick": false, "perMachine": false, "allowToChangeInstallationDirectory": true, "createDesktopShortcut": true, "createStartMenuShortcut": true, "shortcutName": "Cubiverso Launcher", "artifactName": "Cubiverso-Launcher-Instalador.exe", "language": "3082"},
    "portable": {"artifactName": "Cubiverso-Launcher-Portable.exe"}
  },
  "dependencies": {"adm-zip": "0.5.16"},
  "devDependencies": {"electron": "33.2.1", "electron-builder": "25.1.8"}
}
