<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- Cubiverso lo usan niños: no se usa el identificador de publicidad del móvil -->
    <uses-permission android:name="com.google.android.gms.permission.AD_ID" tools:node="remove" />
    <application>
        <!-- Identificador de la app en AdMob. Ahora es el de PRUEBA de Google: cámbialo por el tuyo
             (AdMob → Apps → Configuración de la app) para cobrar por los anuncios. -->
        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="ca-app-pub-3940256099942544~3347511713" />
    </application>
</manifest>
